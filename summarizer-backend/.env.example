# Required: your OpenRouter API key (the product pays for summaries, users don't).
OPENROUTER_API_KEY=

# Optional: shared install token. If set, /summarize requires
# Authorization: Bearer <this>. Strongly recommended in production.
SUMMARIZER_TOKEN=

# Cheap model for summaries (OpenRouter slug).
SUMMARIZER_MODEL=openai/gpt-oss-120b

# Railway sets PORT automatically; default for local runs.
PORT=8090
