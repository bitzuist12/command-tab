# OpenAI-compatible endpoint. Default = OpenRouter (hosted).
# For FULLY ON-DEVICE summarization (nothing leaves the machine), point at a
# local model instead — the privacy-max default for WhatsApp:
#   Ollama:    LLM_BASE_URL=http://127.0.0.1:11434/v1   SUMMARIZER_MODEL=qwen2.5:3b
#   llama.cpp: LLM_BASE_URL=http://127.0.0.1:8080/v1    (llama-server -m model.gguf)
LLM_BASE_URL=https://openrouter.ai/api/v1

# API key for the endpoint above. Required for hosted (OpenRouter); a local
# model needs none. (OPENROUTER_API_KEY is also accepted for back-compat.)
LLM_API_KEY=

# Model id/slug. Hosted: openai/gpt-oss-120b. Local: qwen2.5:3b, llama3.2:3b, ...
SUMMARIZER_MODEL=openai/gpt-oss-120b

# Optional: shared install token. If set, /summarize requires
# Authorization: Bearer <this>. Recommended for the hosted deployment.
SUMMARIZER_TOKEN=

# Railway sets PORT automatically; default for local runs.
PORT=8090
