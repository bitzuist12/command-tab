{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Tab WhatsApp",
  "version": "0.1.0",
  "identifier": "ai.analystai.commandtab.whatsapp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Command Tab — WhatsApp",
        "width": 1100,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
